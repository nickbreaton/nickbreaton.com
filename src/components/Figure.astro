---
interface Props {
	center?: boolean;
}

const { center = false } = Astro.props;
---

<figure
	class:list={[
		"mb-5 min-h-40 touch-manipulation select-none rounded-lg border border-neutral-200 bg-white p-5 *:first:mt-0 *:last:mb-0 dark:border-neutral-800 dark:bg-neutral-800/25",
		center && "flex flex-col items-center justify-center",
	]}
>
	<slot />
</figure>
