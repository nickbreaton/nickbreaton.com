---
import IconLetterN from "@tabler/icons/outline/letter-n.svg";
import "../../src/styles/global.css";
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="color-scheme" content="light dark" />
	</head>
	<body class="m-0 bg-transparent">
		<div
			id="icon"
			class="flex size-(--size) items-center justify-center rounded-(--radius) [corner-shape:superellipse(1.5)] bg-[oklch(89.5%_0_0)] dark:bg-neutral-600"
		>
			<IconLetterN aria-hidden="true" class="size-(--icon-size) stroke-[3] text-neutral-500 dark:text-white" />
		</div>
	</body>
</html>
