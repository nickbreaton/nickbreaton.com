---
import { Font } from "astro:assets";
import "../../src/styles/global.css";
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="color-scheme" content="light dark" />
		<Font cssVariable="--font-lexend" preload />
	</head>
	<body class="m-0 bg-transparent">
		<div
			id="icon"
			class="flex size-(--size) items-center justify-center rounded-(--radius) [corner-shape:superellipse(1.5)] bg-neutral-200 dark:bg-neutral-600"
		>
			<h1 class="font-sans text-(length:--font-size) leading-none font-bold tracking-[-0.05em] text-neutral-500 dark:text-white">//</h1>
		</div>
	</body>
</html>
