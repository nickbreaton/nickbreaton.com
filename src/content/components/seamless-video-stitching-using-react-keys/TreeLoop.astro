import Figure from "../../../components/Figure.astro";
import fallHevc from "./tree-fall.mp4";
import fallWebm from "./tree-fall.webm";
import springHevc from "./tree-spring.mp4";
import springWebm from "./tree-spring.webm";
import summerHevc from "./tree-summer.mp4";
import summerWebm from "./tree-summer.webm";
import winterHevc from "./tree-winter.mp4";
import winterWebm from "./tree-winter.webm";

const clips = [
	{ webm: springWebm, hevc: springHevc },
	{ webm: summerWebm, hevc: summerHevc },
	{ webm: fallWebm, hevc: fallHevc },
	{ webm: winterWebm, hevc: winterHevc },
];
---

<Figure center>
	<div data-tree-loop class="grid size-72">
		{
			clips.map((clip, i) => (
				<video
					data-webm={clip.webm}
					data-hevc={clip.hevc}
					class:list={["col-start-1 row-start-1 size-full", i !== 0 && "opacity-0"]}
					preload="auto"
					muted
					playsinline
				/>
			))
		}
	</div>
</Figure>

<script>
	const videos = [
		...document.querySelectorAll<HTMLVideoElement>("[data-tree-loop] video"),
	];

	const ua = navigator.userAgent;
	const webkit = /AppleWebKit/.test(ua) && !/Chrome|Chromium|Edg|Android/.test(ua);

	for (const video of videos) {
		video.src = webkit ? video.dataset.hevc! : video.dataset.webm!;
	}

	for (const video of videos.slice(1)) {
		video.play().then(() => {
			video.pause();
			video.currentTime = 0;
		});
	}

	let index = 0;
	videos[index]!.play();

	for (const video of videos) {
		video.addEventListener("ended", () => {
			const next = videos[(index + 1) % videos.length]!;
			if (next.currentTime !== 0) next.currentTime = 0;
			next.play();
			next.requestVideoFrameCallback(() => {
				next.classList.remove("opacity-0");
				video.classList.add("opacity-0");
			});
			index = (index + 1) % videos.length;
		});
	}
</script>
