// TODO: TEMPORARY — DO NOT PUBLISH THIS POST WITH THIS COMPONENT AS-IS.
//
// This vanilla JS version only exists to prove that stacking all clips and
// swapping their visibility *can* produce seamless transitions.
//
// It MUST be replaced with an actual React solution before posting.
// ==========================================================================
import Figure from "../../../components/Figure.astro";
import fallHevc from "./tree-fall.mp4";
import fallWebm from "./tree-fall.webm";
import springHevc from "./tree-spring.mp4";
import springWebm from "./tree-spring.webm";
import summerHevc from "./tree-summer.mp4";
import summerWebm from "./tree-summer.webm";
import winterHevc from "./tree-winter.mp4";
import winterWebm from "./tree-winter.webm";

const clips = [
	{ webm: springWebm, hevc: springHevc },
	{ webm: summerWebm, hevc: summerHevc },
	{ webm: fallWebm, hevc: fallHevc },
	{ webm: winterWebm, hevc: winterHevc },
];
---

<Figure center>
	<div data-tree-loop class="grid size-72">
		{
			clips.map((clip, i) => (
				<video
					data-webm={clip.webm}
					data-hevc={clip.hevc}
					class:list={["col-start-1 row-start-1 size-full", i !== 0 && "opacity-0"]}
					preload="auto"
					muted
					playsinline
				/>
			))
		}
	</div>
	<button
		data-tree-toggle
		type="button"
		aria-label="Pause"
		class="absolute top-3 right-3 grid size-8 cursor-pointer place-items-center rounded-full text-neutral-500 transition-colors [-webkit-tap-highlight-color:transparent] hover:bg-neutral-100 hover:text-neutral-900 focus-visible:outline-2 focus-visible:outline-neutral-500 dark:text-neutral-400 dark:hover:bg-neutral-800 dark:hover:text-neutral-100"
	>
		<svg data-icon="pause" viewBox="0 0 16 16" class="size-4" fill="currentColor" aria-hidden="true">
			<rect x="3.5" y="2.5" width="3" height="11" rx="1" />
			<rect x="9.5" y="2.5" width="3" height="11" rx="1" />
		</svg>
		<svg data-icon="play" viewBox="0 0 16 16" class="hidden size-4" fill="currentColor" aria-hidden="true">
			<path d="M4.5 3.37a1 1 0 0 1 1.5-.86l7.13 4.63a1 1 0 0 1 0 1.72L6 13.49a1 1 0 0 1-1.5-.86Z" />
		</svg>
	</button>
</Figure>

<script>
	const videos = [
		...document.querySelectorAll<HTMLVideoElement>("[data-tree-loop] video"),
	];

	const ua = navigator.userAgent;
	const webkit = /AppleWebKit/.test(ua) && !/Chrome|Chromium|Edg|Android/.test(ua);

	for (const video of videos) {
		video.src = webkit ? video.dataset.hevc! : video.dataset.webm!;
	}

	for (const video of videos.slice(1)) {
		video.play().then(() => {
			video.pause();
			video.currentTime = 0;
		});
	}

	const toggle = document.querySelector<HTMLButtonElement>("[data-tree-toggle]")!;
	let paused = matchMedia("(prefers-reduced-motion: reduce)").matches;

	const render = () => {
		toggle.setAttribute("aria-label", paused ? "Play" : "Pause");
		toggle.querySelector("[data-icon=pause]")!.classList.toggle("hidden", paused);
		toggle.querySelector("[data-icon=play]")!.classList.toggle("hidden", !paused);
	};

	let index = 0;
	if (!paused) videos[index]!.play();
	render();

	toggle.addEventListener("click", () => {
		paused = !paused;
		if (paused) videos[index]!.pause();
		else videos[index]!.play();
		render();
	});

	for (const video of videos) {
		video.addEventListener("ended", () => {
			const next = videos[(index + 1) % videos.length]!;
			if (next.currentTime !== 0) next.currentTime = 0;
			next.play();
			next.requestVideoFrameCallback(() => {
				next.classList.remove("opacity-0");
				video.classList.add("opacity-0");
			});
			index = (index + 1) % videos.length;
		});
	}
</script>
