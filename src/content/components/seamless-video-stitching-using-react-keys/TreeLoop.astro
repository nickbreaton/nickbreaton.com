---
import Figure from "../../../components/Figure.astro";
import fallHevc from "./tree-fall.mp4";
import fallWebm from "./tree-fall.webm";
import springHevc from "./tree-spring.mp4";
import springWebm from "./tree-spring.webm";
import summerHevc from "./tree-summer.mp4";
import summerWebm from "./tree-summer.webm";
import winterHevc from "./tree-winter.mp4";
import winterWebm from "./tree-winter.webm";

const sources = {
	webm: [springWebm, summerWebm, fallWebm, winterWebm],
	hevc: [springHevc, summerHevc, fallHevc, winterHevc],
};
---

<Figure center>
	<video
		data-tree-loop
		data-sources={JSON.stringify(sources)}
		class="size-72"
		autoplay
		muted
		playsinline
	/>
</Figure>

<script>
	const video = document.querySelector<HTMLVideoElement>("[data-tree-loop]");
	const { webm, hevc }: Record<"webm" | "hevc", string[]> = JSON.parse(
		video!.dataset.sources!,
	);

	const ua = navigator.userAgent;
	const webkit = /AppleWebKit/.test(ua) && !/Chrome|Chromium|Edg|Android/.test(ua);
	const sources = webkit ? hevc : webm;

	let index = 0;
	video!.src = sources[index]!;

	video!.addEventListener("ended", () => {
		index = (index + 1) % sources.length;
		video!.src = sources[index]!;
		video!.play();
	});
</script>
