---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";

const name = "Nick Breaton";

// const socials = [
// 	{
// 		site: "GitHub",
// 		href: "https://github.com/nickbreaton",
// 	},
// 	{
