---
import { getCollection } from "astro:content";
import IconBrandBluesky from "@tabler/icons/outline/brand-bluesky.svg";
import IconBrandGithub from "@tabler/icons/outline/brand-github.svg";
import IconBrandMastodon from "@tabler/icons/outline/brand-mastodon.svg";
import IconBrandX from "@tabler/icons/outline/brand-x.svg";
import sharp from "sharp";
import Layout from "../layouts/Layout.astro";

const name = "Nick Breaton";
const bio =
	"Software developer with more than ten years of experience building web applications in an ever-changing world.";

// Inlined so the photo renders with the HTML instead of waiting on a request.
// Encoded at 2x the largest display width so it stays sharp on retina screens.
const photoWidth = 240;
const photo = await sharp("src/images/me.jpeg")
	.rotate()
	.resize(photoWidth * 2)
	.avif({ quality: 50 })
	.toBuffer();
const photoSrc = `data:image/avif;base64,${photo.toString("base64")}`;

const socials = [
	{
		site: "GitHub",
		href: "https://github.com/nickbreaton",
		icon: IconBrandGithub,
	},
	{
		site: "X",
		href: "https://x.com/nickbreaton",
		icon: IconBrandX,
	},
	{
		site: "Bluesky",
		href: "https://bsky.app/profile/nickbreaton.com",
		icon: IconBrandBluesky,
	},
	{
		site: "Mastodon",
		href: "https://mastodon.social/@nickbreaton",
		rel: "me",
		icon: IconBrandMastodon,
	},
];

const posts = (await getCollection("posts"))
	.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
	.map((post) => ({ title: post.data.title, href: `/posts/${post.id}` }));
---

<Layout title={name} description={bio}>
	<img
		src={photoSrc}
		width={photoWidth}
		height={photoWidth}
		alt="Nick facing camera with quaint street behind him"
		class="w-32 rounded-xl bg-neutral-200 [corner-shape:squircle] sm:w-60 dark:bg-neutral-950"
	/>
	<section class="mt-6 mb-10">
		<h1 class="text-title">{name}</h1>
		<p class="mt-3 text-body">{bio}</p>
		<div class="mt-4 flex gap-3">
			{socials.map(({ site, href, rel, icon: Icon }) => (
				<a
					href={href}
					rel={rel}
					target="_blank"
					title={site}
					class="hover:text-foreground"
				>
					<Icon aria-hidden="true" class="size-5" />
				</a>
			))}
		</div>
	</section>
	<h2 class="text-heading">Posts</h2>
	<ul class="mt-2 flex flex-col gap-1">
		{posts.map(({ title, href }) => (
			<li>
				<a
					href={href}
					class="text-body text-muted-foreground underline-offset-4 hover:text-foreground hover:underline"
				>
					{title}
				</a>
			</li>
		))}
	</ul>
</Layout>
