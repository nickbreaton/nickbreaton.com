---
import { Font, getImage } from "astro:assets";
import mePhoto from "../images/me.jpeg";
import { name } from "../site";
import "../styles/global.css";

interface Props {
	title: string;
	description?: string;
	type?: "website" | "article";
	publishedTime?: Date;
}

const { title, description, type = "website", publishedTime } = Astro.props;
const url = new URL(Astro.url.pathname, Astro.site);

// Social crawlers can't read data URIs or reliably decode AVIF, so link preview
// cards get a separately hosted JPEG.
const ogImageWidth = 1200;
const ogImage = await getImage({
	src: mePhoto,
	width: ogImageWidth,
	height: ogImageWidth,
	format: "jpeg",
});
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta
			name="viewport"
			content="width=device-width, initial-scale=1.0, maximum-scale=1.0, minimum-scale=1.0, user-scalable=no"
		/>
		<meta name="color-scheme" content="light dark" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		{description && <meta name="description" content={description} />}
		<meta property="og:type" content={type} />
		{publishedTime && (
			<meta
				property="article:published_time"
				content={publishedTime.toISOString()}
			/>
		)}
		<meta property="og:site_name" content={name} />
		<meta property="og:url" content={url} />
		<meta property="og:title" content={title} />
		{description && <meta property="og:description" content={description} />}
		<meta property="og:image" content={new URL(ogImage.src, Astro.site)} />
		<meta property="og:image:width" content={String(ogImageWidth)} />
		<meta property="og:image:height" content={String(ogImageWidth)} />
		<meta property="og:image:alt" content={`Profile picture of ${name}`} />
		<meta name="twitter:card" content="summary" />
		{Astro.routePattern === "/" && (
			<script
				type="application/ld+json"
				set:html={JSON.stringify({
					"@context": "https://schema.org",
					"@type": "WebSite",
					name,
					url: Astro.site,
				}).replace(/</g, "\\u003c")}
			/>
		)}
		<Font cssVariable="--font-lexend" preload />
		<Font cssVariable="--font-ibm-plex-mono" preload />
	</head>
	<body class="bg-background text-muted-foreground leading-relaxed mx-auto max-w-lg px-5 py-8">
		<slot />
	</body>
</html>
