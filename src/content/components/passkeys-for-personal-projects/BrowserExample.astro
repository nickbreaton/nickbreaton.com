---
import Figure from "../../../components/Figure.astro";
import Button from "./Button.astro";
---

<Figure center>
	<Button data-create-passkey>Create passkey</Button>
	<div data-passkey-result hidden class="w-full">
		<p class="text-sm!">Provide this to your administrator (copy it into the environment variable field below).</p>
		<pre
			class="rounded-md bg-neutral-500/15 p-3 font-mono text-sm break-all whitespace-pre-wrap select-all"><code data-passkey></code></pre>
	</div>
</Figure>

<script>
	const button = document.querySelector<HTMLButtonElement>("[data-create-passkey]");
	const result = document.querySelector<HTMLElement>("[data-passkey-result]");
	const passkey = document.querySelector<HTMLElement>("[data-passkey]");

	const toBase64Url = (buffer: ArrayBuffer) =>
		btoa(String.fromCharCode(...new Uint8Array(buffer)))
			.replace(/\+/g, "-")
			.replace(/\//g, "_")
			.replace(/=+$/, "");

	button?.addEventListener("click", async () => {
		const credential = (await navigator.credentials.create({
			publicKey: {
				// The public key is trusted as-is, so there's no server challenge or attestation to verify.
				challenge: crypto.getRandomValues(new Uint8Array(32)),
				rp: { name: location.hostname },
				user: {
					id: crypto.getRandomValues(new Uint8Array(16)),
					name: "Passkeys for personal projects",
					displayName: "Passkeys for personal projects",
				},
				// ES256 and RS256 cover every common authenticator.
				pubKeyCredParams: [
					{ type: "public-key", alg: -7 },
					{ type: "public-key", alg: -257 },
				],
				authenticatorSelection: { residentKey: "required", userVerification: "preferred" },
				attestation: "none",
			},
		})) as PublicKeyCredential | null;

		if (!credential) return;

		const response = credential.response as AuthenticatorAttestationResponse;
		const publicKey = response.getPublicKey();

		if (!publicKey) return;

		passkey!.textContent = toBase64Url(publicKey);
		button!.hidden = true;
		result!.hidden = false;
	});
</script>
